+/// 调用目标和实参都可能含有函数字面量，不为调用本身命名。
+fn walk_call(
+    node: &ast::Call,
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    walk_expression(&node.func, parent, index, output);
+    for argument in &node.args {
+        walk_expression(argument, parent, index, output);
+    }
+}
