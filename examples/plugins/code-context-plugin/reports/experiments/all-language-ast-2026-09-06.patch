@@ -0,0 +1,133 @@
+//! 混合文件分派：容器与每段嵌入源码各用对应语法解析器，并保留原文件坐标。
+
+use super::{documents, tree_sitter, vue, Language, ParseOutput};
+use vue::{EmbeddedKind, EmbeddedSection};
+
+/// 组合 Vue 脚本、HTML 模板和各样式方言，未知嵌入内容明确保留部分解析状态。
+pub(super) fn parse_vue(source: &str) -> Option<ParseOutput> {
+    let mut output = vue::parse(source)?;
+    for (position, section) in vue::embedded_sections(source)?.into_iter().enumerate() {
+        if position >= embedded_limit(source) {
+            output.has_errors = true;
+            break;
+        }
+        if section.kind == EmbeddedKind::Script {
+            continue;
+        }
+        parse_section(source, &section, &mut output);
+    }
+    Some(output)
+}
+
+/// 先解析 HTML 容器，再解析真实标签内的脚本与样式；不执行脚本或访问外链。
+pub(super) fn parse_html(source: &str) -> Option<ParseOutput> {
+    let mut output = tree_sitter::parse("embedded.html", Language::Html, source)?;
+    for (position, section) in vue::html_sections(source)?.into_iter().enumerate() {
+        if position >= embedded_limit(source) {
+            output.has_errors = true;
+            break;
+        }
+        parse_section(source, &section, &mut output);
+    }
+    Some(output)
+}
+
+/// 限制一个文件的重复掩码与解析总量，避免大量微小标签产生平方级开销。
+pub(super) fn embedded_limit(source: &str) -> usize {
+    (8 * 1024 * 1024 / source.len().max(1)).clamp(1, 32)
+}
+
+/// 按标签声明的真实方言解析内文，不用某个相近语言冒充语法成功。
+fn parse_section(source: &str, section: &EmbeddedSection, output: &mut ParseOutput) {
+    output.has_errors |= !section.closed;
+    if section.external
+        || source
+            .get(section.start..section.end)
+            .is_none_or(|s| s.trim().is_empty())
+    {
+        return;
+    }
+    let Some(masked) = vue::mask_section(source, section) else {
+        output.has_errors = true;
+        return;
+    };
+    if section.kind == EmbeddedKind::Script {
+        match section
+            .mime_type
+            .as_deref()
+            .map(|mime| mime.split(';').next().unwrap_or(mime).trim())
+        {
+            Some("application/json" | "application/ld+json" | "importmap" | "speculationrules") => {
+                if let Some(parsed) = documents::parse("embedded.json", Language::Json, &masked) {
+                    merge(output, parsed);
+                } else {
+                    output.has_errors = true;
+                }
+                return;
+            }
+            None
+            | Some(
+                "module"
+                | "text/javascript"
+                | "application/javascript"
+                | "text/ecmascript"
+                | "application/ecmascript",
+            ) => {}
+            _ => {
+                output.has_errors = true;
+                return;
+            }
+        }
+    }
+    let parsed = match (section.kind, section.language.as_deref()) {
+        (EmbeddedKind::Template, None | Some("html")) => {
+            // Vue 模板内的 script 是模板节点，不能被提取成顶层可执行声明。
+            tree_sitter::parse("embedded.html", Language::Html, &masked)
+        }
+        (EmbeddedKind::Style, None | Some("css")) => {
+            documents::parse("embedded.css", Language::Css, &masked)
+        }
+        (EmbeddedKind::Style, Some(dialect @ ("scss" | "sass" | "less"))) => {
+            documents::parse(&format!("embedded.{dialect}"), Language::Css, &masked)
+        }
+        (EmbeddedKind::Script, None | Some("js" | "javascript" | "jsx" | "renderjs")) => {
+            super::typescript::parse(&masked, false)
+        }
+        (EmbeddedKind::Script, Some("ts" | "typescript" | "tsx")) => super::typescript::parse_path(
+            if section.language.as_deref() == Some("tsx") {
+                "embedded.tsx"
+            } else {
+                "embedded.ts"
+            },
+            &masked,
+        ),
+        _ => None,
+    };
+    if let Some(parsed) = parsed {
+        merge(output, parsed);
+    } else {
+        output.has_errors = true;
+    }
+}
+
+/// 合并同一原始坐标系的 AST；父下标随声明偏移，导入只保留一份。
+pub(super) fn merge(output: &mut ParseOutput, mut parsed: ParseOutput) {
+    let base = output.declarations.len();
+    for declaration in &mut parsed.declarations {
+        declaration.parent = declaration.parent.map(|parent| parent + base);
+    }
+    for region in &mut parsed.regions {
+        region.parent = region.parent.map(|parent| parent + base);
+    }
+    output.declarations.extend(parsed.declarations);
+    output.regions.extend(parsed.regions);
+    output.has_errors |= parsed.has_errors;
+    for import in parsed.imports {
+        if output.imports.len() < super::MAX_IMPORTS && !output.imports.contains(&import) {
+            output.imports.push(import);
+        }
+    }
+    if output.file_doc.is_none() {
+        output.file_doc = parsed.file_doc;
+    }
+}
