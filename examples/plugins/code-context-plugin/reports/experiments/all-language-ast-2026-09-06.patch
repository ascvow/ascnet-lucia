+/// gosyn 的部分复合表达式 pos 指向中间分隔符，起点必须沿 AST 取左端子节点。
+fn expression_start(node: &ast::Expression) -> usize {
+    match node {
+        ast::Expression::Call(node) => expression_start(&node.func),
+        ast::Expression::Index(node) => expression_start(&node.left),
+        ast::Expression::IndexList(node) => expression_start(&node.left),
+        ast::Expression::Slice(node) => expression_start(&node.left),
+        ast::Expression::Selector(node) => expression_start(&node.x),
+        ast::Expression::TypeAssert(node) => expression_start(&node.left),
+        ast::Expression::CompositeLit(node) => expression_start(&node.typ),
+        ast::Expression::Operation(node) => node.pos.min(expression_start(&node.x)),
+        ast::Expression::List(nodes) => {
+            nodes.iter().map(expression_start).min().unwrap_or_default()
+        }
+        // 接口方法的 FuncType 没有 func 词元，gosyn 将 pos 留作 0；应从真实参数列表起点计算。
+        ast::Expression::TypeFunction(node) if node.pos == 0 => {
+            node.params.pos.map_or(0, |(start, _)| start)
+        }
+        _ => node.pos(),
+    }
+}
