+/// 复合字面量的每个真实元素保留结构范围，嵌套省略类型的字面量仍按 AST 遍历。
+fn walk_literal(
+    node: &ast::LiteralValue,
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    push_region(node.pos.0, node.pos.1, parent, index, output);
+    for element in &node.values {
+        for value in element.key.iter().chain(std::iter::once(&element.val)) {
+            match value {
+                ast::Element::Expr(expression) => {
+                    push_region(
+                        expression_start(expression),
+                        expression_end(expression),
+                        parent,
+                        index,
+                        output,
+                    );
+                    walk_expression(expression, parent, index, output);
+                }
+                ast::Element::LitValue(value) => walk_literal(value, parent, index, output),
+            }
+        }
+    }
+}
