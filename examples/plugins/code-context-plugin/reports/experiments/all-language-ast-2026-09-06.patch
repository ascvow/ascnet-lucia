+//! 把 AST 区域装配为有界源码块，保留声明导航并补齐长声明与无名结构。
+
+use super::{
+    chunk_id, is_substantive_block, is_test_path, qualified_name, separator_of, CodeChunk,
+    Language, ParseOutput, RepositoryIdentity, SymbolKind, MAX_CHUNKS_PER_FILE,
+    SEMANTIC_GROUP_MAX_CHARS, TEXT_CHUNK_LINES,
+};
+use crate::repository::content_hash;
+use std::collections::BTreeSet;
+
+/// 为原子声明尚未完整覆盖的正文补块；返回是否不得不切开超长语法叶节点。
+///
+/// 区域只提供切点，不能制造函数或配置键符号。较短声明保留原有语义表示；长声明中的
+/// 实际语句边界用于生成包含尾部的独立语义文档。正文始终来自原文件的闭区间行范围。
+pub(super) fn append(
+    repository: &RepositoryIdentity,
+    file_path: &str,
+    language: Language,
+    lines: &[&str],
+    output: &ParseOutput,
+    chunks: &mut Vec<CodeChunk>,
+) -> bool {
+    let mut chars = Vec::with_capacity(lines.len() + 1);
+    chars.push(0usize);
+    for line in lines {
+        chars.push(chars.last().copied().unwrap_or_default() + line.chars().count() + 1);
+    }
+    let mut covered = vec![false; lines.len()];
+    for declaration in &output.declarations {
+        let start = declaration.start_line.saturating_sub(1) as usize;
+        let end = (declaration.end_line as usize).min(lines.len());
+        if start >= end || chars[end] - chars[start] > SEMANTIC_GROUP_MAX_CHARS {
+            continue;
+        }
+        covered[start..end].fill(true);
+    }
+    let mut boundaries = BTreeSet::new();
+    for region in &output.regions {
+        let start = region.start_line.saturating_sub(1) as usize;
+        let end = (region.end_line as usize).min(lines.len());
+        if start < end {
+            boundaries.insert(start);
+            boundaries.insert(end);
+        }
+    }
+    let mut declaration_boundaries = BTreeSet::new();
+    for declaration in &output.declarations {
+        declaration_boundaries.insert(declaration.start_line.saturating_sub(1) as usize);
+        declaration_boundaries.insert((declaration.end_line as usize).min(lines.len()));
+        boundaries.insert(declaration.start_line.saturating_sub(1) as usize);
+        boundaries.insert((declaration.end_line as usize).min(lines.len()));
+    }
+
+    let mut fallback = false;
+    let mut start = 0usize;
+    while start < lines.len() && chunks.len() < MAX_CHUNKS_PER_FILE {
+        if covered[start] {
+            start += 1;
+            continue;
+        }
+        let gap_end = (start..lines.len())
+            .find(|index| covered[*index])
+            .unwrap_or(lines.len());
+        while start < gap_end && chunks.len() < MAX_CHUNKS_PER_FILE {
+            let mut hard_end = start + 1;
+            while hard_end < gap_end
+                && hard_end - start < TEXT_CHUNK_LINES as usize
+                && chars[hard_end + 1] - chars[start] <= SEMANTIC_GROUP_MAX_CHARS
+            {
+                hard_end += 1;
+            }
+            // 声明边界不可跨越：不能把前一函数尾部与后一函数文档拼成可合并的桥接块。
+            if let Some(boundary) = declaration_boundaries.range(start + 1..=hard_end).next() {
+                hard_end = *boundary;
+            }
+            let end = if hard_end == gap_end {
+                gap_end
+            } else if let Some(boundary) = boundaries.range(start + 1..=hard_end).next_back() {
+                *boundary
+            } else {
+                // 一个叶节点本身超过预算时，仅该区域使用行窗口，其他健康 AST 仍保留。
+                fallback = true;
+                hard_end
+            };
+            fallback |= chars[end] - chars[start] > SEMANTIC_GROUP_MAX_CHARS;
+            let body_lines = &lines[start..end];
+            if is_substantive_block(body_lines) {
+                let parent = output
+                    .declarations
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, declaration)| {
+                        declaration.start_line as usize <= start + 1
+                            && declaration.end_line as usize >= end
+                    })
+                    .min_by_key(|(_, declaration)| declaration.end_line - declaration.start_line);
+                let parent_symbol = parent.map(|(index, _)| {
+                    qualified_name(&output.declarations, index, separator_of(language))
+                });
+                let body = body_lines.join("\n");
+                chunks.push(CodeChunk {
+                    id: chunk_id(
+                        repository,
+                        file_path,
+                        "ast-region",
+                        SymbolKind::Other,
+                        chunks.len(),
+                    ),
+                    repository_id: repository.clone(),
+                    file_path: file_path.to_string(),
+                    language: language.as_str().to_string(),
+                    symbol_name: None,
+                    qualified_symbol: None,
+                    symbol_kind: None,
+                    parent_symbol,
+                    start_line: (start + 1) as u32,
+                    end_line: end as u32,
+                    signature: parent.and_then(|(_, declaration)| declaration.signature.clone()),
+                    doc_comment: parent
+                        .and_then(|(_, declaration)| declaration.doc_comment.clone())
+                        .map(|doc| super::truncate(doc, super::MAX_DOC_LEN)),
+                    is_test: is_test_path(file_path)
+                        || parent.is_some_and(|(_, declaration)| declaration.is_test),
+                    // 父声明已提供完整词法正文，这些子区间只补充语义召回。
+                    semantic_only: parent.is_some(),
+                    semantic_group_id: None,
+                    imports: output
+                        .imports
+                        .iter()
+                        .take(super::MAX_IMPORTS)
+                        .cloned()
+                        .collect(),
+                    content_hash: content_hash(&body),
+                });
+            }
+            start = end;
+        }
+    }
+    if language == Language::Vue {
+        append_vue_context_windows(repository, file_path, language, lines, output, chunks);
+    }
+    fallback || start < lines.len()
+}
+
+/// 保留 Vue 既有全文件语义窗口，让相邻声明和长函数共同提供业务语境。
+///
+/// AST 声明与区域继续负责精确导航。窗口沿用既有文本分块边界且仅进入语义通道；
+/// 不新增符号或词法证据，也不改变短声明复合组和其成员的向量参与规则。
+fn append_vue_context_windows(
+    repository: &RepositoryIdentity,
+    file_path: &str,
+    language: Language,
+    lines: &[&str],
+    output: &ParseOutput,
+    chunks: &mut Vec<CodeChunk>,
+) {
+    for mut window in super::text_chunks(repository, file_path, language, lines) {
+        if chunks.len() >= MAX_CHUNKS_PER_FILE {
+            break;
+        }
+        if !output.declarations.iter().any(|declaration| {
+            declaration.start_line <= window.end_line && declaration.end_line >= window.start_line
+        }) {
+            continue;
+        }
+        // 已有无名语义块只要覆盖和正文完全相同，就复用它而不制造重复向量。
+        if chunks.iter().any(|chunk| {
+            chunk.symbol_name.is_none()
+                && (chunk.semantic_only || chunk.semantic_group_id.is_none())
+                && chunk.start_line == window.start_line
+                && chunk.end_line == window.end_line
+                && chunk.content_hash == window.content_hash
+        }) {
+            continue;
+        }
+        window.id = chunk_id(
+            repository,
+            file_path,
+            "sfc-context",
+            SymbolKind::Other,
+            chunks.len(),
+        );
+        window.semantic_only = true;
+        chunks.push(window);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::parser::{parse_file, ParseTier};
+
+    /// 短操作和超过短组阈值的决策函数仍共享 Vue 语境，同时保持各自完整符号范围。
+    #[test]
+    fn vue_context_windows_keep_adjacent_implementations_together() {
+        let repository = RepositoryIdentity::from_workspace_root("/repo/sfc-context").unwrap();
+        let source = "<script setup>\nfunction activatePanel(player) {\n  panelOpen.value = true;\n  player.pause();\n}\n\nfunction maybeActivatePanel(player) {\n  const duration = player.duration;\n  if (duration <= 0) {\n    return;\n  }\n  if (player.currentTime < duration / 2) return;\n  activatePanel(player);\n}\n</script>\n";
+        let parsed = parse_file(&repository, "src/PlayerPanel.vue", Language::Vue, source);
+        let symbols: Vec<_> = parsed
+            .symbols
+            .iter()
+            .map(|symbol| (symbol.name.as_str(), symbol.start_line, symbol.end_line))
+            .collect();
+        assert_eq!(
+            symbols,
+            [("activatePanel", 2, 5), ("maybeActivatePanel", 7, 14)]
+        );
+        let lines: Vec<_> = source.lines().collect();
+        let windows: Vec<_> = parsed
+            .chunks
+            .iter()
+            .filter(|chunk| chunk.semantic_only && chunk.start_line <= 2 && chunk.end_line >= 14)
+            .collect();
+        assert_eq!(windows.len(), 1);
+        assert!(windows[0].symbol_name.is_none());
+        let body =
+            lines[windows[0].start_line as usize - 1..windows[0].end_line as usize].join("\n");
+        let document = crate::semantic_document_text(windows[0], None, Some(&body));
+        assert!(document.contains("player.pause()"));
+        assert!(document.contains("player.currentTime < duration / 2"));
+    }
+
+    /// 同范围同正文的既有无名语义块不再增加向量，且重复装配保持幂等。
+    #[test]
+    fn vue_context_windows_do_not_duplicate_existing_semantic_ranges() {
+        let repository = RepositoryIdentity::from_workspace_root("/repo/sfc-dedup").unwrap();
+        let source = "<script setup>\nfunction refresh() { reload(); }\n</script>\n";
+        let output = super::super::vue::parse(source).unwrap();
+        let lines: Vec<_> = source.lines().collect();
+        let mut chunks =
+            super::super::text_chunks(&repository, "src/Panel.vue", Language::Vue, &lines);
+        chunks[0].semantic_only = true;
+        let initial = chunks.len();
+        append_vue_context_windows(
+            &repository,
+            "src/Panel.vue",
+            Language::Vue,
+            &lines,
+            &output,
+            &mut chunks,
+        );
+        append_vue_context_windows(
+            &repository,
+            "src/Panel.vue",
+            Language::Vue,
+            &lines,
+            &output,
+            &mut chunks,
+        );
+        assert_eq!(chunks.len(), initial);
+    }
+
+    /// 长声明的最后一步必须出现在某个实际语义文档中，不能只有完整符号表而缺尾部向量。
+    #[test]
+    fn statement_windows_embed_the_end_of_a_long_function() {
+        let repository = RepositoryIdentity::from_workspace_root("/repo/long-body").unwrap();
+        let mut source = String::from("pub fn synchronize() {\n");
+        for index in 0..90 {
+            source.push_str(&format!(
+                "    record_stage({index}, \"校验本次处理中间结果\");\n"
+            ));
+        }
+        source.push_str("    publish_completion_receipt();\n}\n");
+        let parsed = parse_file(&repository, "src/sync.rs", Language::Rust, &source);
+        assert_eq!(parsed.tier, ParseTier::Structural);
+        let lines: Vec<_> = source.lines().collect();
+        assert!(parsed
+            .chunks
+            .iter()
+            .filter(|chunk| chunk.semantic_only)
+            .any(|chunk| {
+                let body = lines[chunk.start_line as usize - 1..chunk.end_line as usize].join("\n");
+                crate::semantic_document_text(chunk, None, Some(&body))
+                    .contains("publish_completion_receipt")
+            }));
+        let symbol = parsed
+            .symbols
+            .iter()
+            .find(|symbol| symbol.name == "synchronize")
+            .unwrap();
+        assert_eq!(symbol.end_line as usize, source.lines().count());
+        for chunk in parsed.chunks.iter().filter(|chunk| chunk.semantic_only) {
+            let body = lines[chunk.start_line as usize - 1..chunk.end_line as usize].join("\n");
+            assert!(body.chars().count() <= SEMANTIC_GROUP_MAX_CHARS);
+            assert_eq!(chunk.parent_symbol.as_deref(), Some("synchronize"));
+        }
+    }
+
+    /// 父声明的长文档不能绕过原子块的元数据预算，导致子区间发送超长重复提示。
+    #[test]
+    fn long_regions_keep_parent_documentation_bounded() {
+        let repository = RepositoryIdentity::from_workspace_root("/repo/document-budget").unwrap();
+        let source = format!(
+            "/// {}\npub fn refresh() {{\n{}\n}}\n",
+            "说明文字".repeat(300),
+            "    record_state();\n".repeat(100),
+        );
+        let parsed = parse_file(&repository, "src/state.rs", Language::Rust, &source);
+        let regions: Vec<_> = parsed
+            .chunks
+            .iter()
+            .filter(|chunk| chunk.semantic_only)
+            .collect();
+        assert!(!regions.is_empty());
+        assert!(regions.iter().all(|chunk| {
+            chunk
+                .doc_comment
+                .as_deref()
+                .is_none_or(|doc| doc.chars().count() <= super::super::MAX_DOC_LEN)
+        }));
+    }
+
+    /// 行级模型无法拆开单行叶节点时必须如实标明局部回退，原文仍然保留。
+    #[test]
+    fn oversized_single_line_keeps_source_and_reports_partial() {
+        let repository = RepositoryIdentity::from_workspace_root("/repo/long-line").unwrap();
+        let source = format!("pub const VALUE: &str = \"{}\";", "值".repeat(2000));
+        let parsed = parse_file(&repository, "src/value.rs", Language::Rust, &source);
+        assert_eq!(parsed.tier, ParseTier::Partial);
+        assert!(!parsed.chunks.is_empty());
+        assert!(parsed
+            .chunks
+            .iter()
+            .all(|chunk| chunk.content_hash == content_hash(&source)));
+    }
+}
