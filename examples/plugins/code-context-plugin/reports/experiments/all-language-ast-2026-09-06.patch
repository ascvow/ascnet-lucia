+            .enumerate()
+            .find(|(_, d)| d.name == "total")
+            .unwrap();
+        assert_eq!(declaration.kind, SymbolKind::Function);
+        assert!(output
+            .regions
+            .iter()
+            .any(|r| r.parent == Some(index) && r.start_line == 3 && r.end_line == 3));
+        assert!(output
+            .regions
+            .iter()
+            .any(|r| r.parent == Some(index) && r.start_line == 4 && r.end_line == 4));
