+/// 保留字段的完整签名和标签范围，字段类型按相同 AST 递归处理。
+fn walk_fields(
+    fields: &[ast::Field],
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    for field in fields {
+        let start = field
+            .name
+            .first()
+            .map_or_else(|| expression_start(&field.typ), |name| name.pos);
+        let end = field.tag.as_ref().map_or_else(
+            || expression_end(&field.typ),
+            |tag| text_end(tag.pos, &tag.value),
+        );
+        push_region(start, end, parent, index, output);
+        walk_expression(&field.typ, parent, index, output);
+    }
+}
