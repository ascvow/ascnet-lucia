+/// 错误恢复不得丢掉健康兄弟；中文 CRLF 的字节偏移必须映射到原始行号。
+#[test]
+fn errors_and_multibyte_crlf_preserve_healthy_implementations() {
+    // 用分号截断错误标记；`@@@ broken` 会被 Java 正确恢复成 `@@` 错误和合法的 `@ broken` 注解。
+    let source = "// 中文账目\r\nclass Ledger {\r\n  int total(int value) {\r\n    return value + 1;\r\n  }\r\n  @@@;\r\n  int reserve() { return 2; }\r\n}\r\n";
+    let parsed = parse_path("Ledger.java", source);
+    assert_eq!(parsed.tier, ParseTier::Partial);
+    for (name, start, end) in [("total", 3, 5), ("reserve", 7, 7)] {
+        let symbol = parsed
+            .symbols
+            .iter()
+            .find(|symbol| symbol.name == name)
+            .expect("健康声明");
+        assert_eq!((symbol.start_line, symbol.end_line), (start, end));
+        assert!(parsed
+            .chunks
+            .iter()
+            .any(|chunk| chunk.symbol_name.as_deref() == Some(name)
+                && chunk.start_line == start
+                && chunk.end_line == end));
+    }
+    assert_eq!(
+        parsed
+            .symbols
+            .iter()
+            .filter(|symbol| symbol.kind == SymbolKind::Function)
+            .count(),
+        2
+    );
+}
