+/// switch 与类型 switch 共用同一 AST 分支容器，保留分支头和内部语句的边界。
+fn walk_cases(
+    node: &ast::CaseBlock,
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    push_region(node.pos.0, node.pos.1, parent, index, output);
+    for clause in &node.body {
+        push_region(clause.pos.0, clause.pos.1, parent, index, output);
+        for expression in &clause.list {
+            walk_expression(expression, parent, index, output);
+        }
+        for statement in clause.body.iter() {
+            walk_statement(statement, parent, index, output);
+        }
+    }
+}
