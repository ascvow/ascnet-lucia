+    /// 大函数的完整循环和返回语句必须留下 AST 区域，供上层按语句切块保留尾部。
+    #[test]
+    fn function_regions_have_declaration_parent() {
+        let output = parse_grammar(Grammar::Java, "class Ledger {\n int total(int value) {\n  if (value > 10) { value -= 1; }\n  return value;\n }\n}\n").unwrap();
+        let (index, declaration) = output
+            .declarations
