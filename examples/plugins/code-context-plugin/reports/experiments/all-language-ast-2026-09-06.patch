+/// 根据 AST 中的词元和子节点计算语句范围；显式声明由自身类型/右值节点记录。
+fn statement_bounds(node: &ast::Statement) -> Option<(usize, usize)> {
+    Some(match node {
+        ast::Statement::Go(node) => (node.pos, node.call.pos.1),
+        ast::Statement::Defer(node) => (node.pos, node.call.pos.1),
+        ast::Statement::If(node) => (
+            node.pos,
+            node.else_
+                .as_deref()
+                .and_then(statement_bounds)
+                .map_or(node.body.pos.1, |(_, end)| end),
+        ),
+        ast::Statement::For(node) => (node.pos, node.body.pos.1),
+        ast::Statement::Range(node) => (node.pos.0, node.body.pos.1),
+        ast::Statement::Send(node) => (expression_start(&node.chan), expression_end(&node.value)),
+        ast::Statement::Expr(node) => (expression_start(&node.expr), expression_end(&node.expr)),
+        ast::Statement::Block(node) => node.pos,
+        ast::Statement::Empty(node) => (node.pos, node.pos),
+        ast::Statement::Label(node) => (
+            node.pos,
+            statement_bounds(&node.stmt).map_or(node.pos, |(_, end)| end),
+        ),
+        ast::Statement::IncDec(node) => (expression_start(&node.expr), node.pos.saturating_add(1)),
+        ast::Statement::Assign(node) => (
+            node.left
+                .iter()
+                .map(expression_start)
+                .min()
+                .unwrap_or(node.pos),
+            node.right
+                .iter()
+                .map(expression_end)
+                .max()
+                .unwrap_or(node.pos),
+        ),
+        ast::Statement::Return(node) => (
+            node.pos,
+            node.ret
+                .iter()
+                .map(expression_end)
+                .max()
+                .unwrap_or_else(|| text_end(node.pos, "return")),
+        ),
+        ast::Statement::Branch(node) => {
+            let keyword: &'static str = node.key.into();
+            (
+                node.pos,
+                node.ident.as_ref().map_or_else(
+                    || text_end(node.pos, keyword),
+                    |ident| text_end(ident.pos, &ident.name),
+                ),
+            )
+        }
+        ast::Statement::Switch(node) => (node.pos, node.block.pos.1),
+        ast::Statement::Select(node) => (node.pos, node.body.pos.1),
+        ast::Statement::TypeSwitch(node) => (node.pos, node.block.pos.1),
+        ast::Statement::Declaration(_) => return None,
+    })
+}
