+        ast::Expression::Star(node) => expression_end(&node.right),
+        ast::Expression::Paren(node) => node.pos.1,
+        ast::Expression::TypeAssert(node) => node.pos.1,
+        ast::Expression::CompositeLit(node) => node.val.pos.1,
