+//! 只依赖节点种类和字段的适配；不使用源码正则识别声明。
+
+use super::{Declaration, ParseOutput, StructuralRegion};
+use crate::model::SymbolKind;
+use crate::repository::language::Language;
+use ::tree_sitter as ts;
+use std::ops::ControlFlow;
+use std::time::{Duration, Instant};
+use ts::{Node, ParseOptions, Parser};
+
+/// 已通过节点字段验证的语法，不把方言映射到近似语法。
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Grammar {
+    Java,
+    Php,
+    C,
+    Cpp,
+    CSharp,
+    Ruby,
+    Swift,
+    Kotlin,
+    Bash,
+    Zsh,
+    Fish,
+    Sql,
+    Make,
+    Dockerfile,
+    Just,
+    Wit,
+    Proto,
+    Graphql,
+    Toml,
+    Yaml,
+    Html,
+}
+
+impl Grammar {
+    /// 返回官方语法对象，版本不兼容由运行时拒绝。
+    fn language(self) -> ts::Language {
+        match self {
+            Self::Java => tree_sitter_java::LANGUAGE.into(),
+            Self::Php => tree_sitter_php::LANGUAGE_PHP.into(),
+            Self::C => tree_sitter_c::LANGUAGE.into(),
+            Self::Cpp => tree_sitter_cpp::LANGUAGE.into(),
+            Self::CSharp => tree_sitter_c_sharp::LANGUAGE.into(),
+            Self::Ruby => tree_sitter_ruby::LANGUAGE.into(),
+            Self::Swift => tree_sitter_swift::LANGUAGE.into(),
+            Self::Kotlin => tree_sitter_kotlin_ng::LANGUAGE.into(),
+            Self::Bash => tree_sitter_bash::LANGUAGE.into(),
+            Self::Zsh => tree_sitter_zsh::LANGUAGE.into(),
+            Self::Fish => tree_sitter_fish::language(),
+            Self::Sql => tree_sitter_sequel::LANGUAGE.into(),
+            Self::Make => tree_sitter_make::LANGUAGE.into(),
+            Self::Dockerfile => tree_sitter_dockerfile_updated::language(),
+            Self::Proto => tree_sitter_proto::LANGUAGE.into(),
+            Self::Graphql => tree_sitter_graphql::LANGUAGE.into(),
+            Self::Toml => tree_sitter_toml_ng::LANGUAGE.into(),
+            Self::Yaml => tree_sitter_yaml::LANGUAGE.into(),
+            Self::Html => tree_sitter_html::LANGUAGE.into(),
+            Self::Wit => tree_sitter_wit::language(),
+            Self::Just => just_language(),
+        }
+    }
+}
+
+/// 解析源码并保留健康子树；无名字的有效结构通过 `regions` 返回。
+///
+/// 无兼容语法或解析取消时返回 `None`；遍历超限保留已确认的健康子树并标记局部回退。
+fn parse_grammar(grammar: Grammar, source: &str) -> Option<ParseOutput> {
+    // 仓库默认限制为一 MiB；适配器再限制四 MiB，防止绕过扫描器直接调用时无界分配。
+    if source.len() > 4 * 1024 * 1024 {
+        return None;
+    }
+    let started = Instant::now();
+    let mut progress = |_: &ts::ParseState| {
+        if started.elapsed() >= Duration::from_millis(500) {
+            ControlFlow::Break(())
+        } else {
+            ControlFlow::Continue(())
+        }
+    };
+    let mut parser = Parser::new();
+    parser.set_language(&grammar.language()).ok()?;
+    let bytes = source.as_bytes();
+    let tree = parser.parse_with_options(
+        &mut |offset, _| bytes.get(offset..).unwrap_or_default(),
+        None,
+        Some(ParseOptions::new().progress_callback(&mut progress)),
+    )?;
+    let root = tree.root_node();
+    let mut output = ParseOutput {
+        has_errors: root.has_error(),
+        ..ParseOutput::default()
+    };
+    let mut file_comments = Vec::new();
+    let mut prefix = true;
+    let mut owner = None;
+    let mut html_ranges = Vec::new();
+    let mut pending = Vec::new();
+    let mut cursor = root.walk();
+    for node in root.named_children(&mut cursor) {
+        if is_comment(node) {
+            if prefix {
+                file_comments.push(node_text(node, source).to_string());
+            }
+            continue;
+        }
+        prefix = false;
+        if let Some(namespace) = detached_owner(grammar, node, source) {
+            owner = Some(namespace);
+        }
+        pending.push((node, None, owner.clone()));
+        if node.is_error() || node.is_missing() {
+            continue;
+        }
+        output.regions.push(StructuralRegion {
+            start_line: start_line(node),
+            end_line: end_line(node),
+            parent: None,
+        });
+    }
+    output.file_doc = (!file_comments.is_empty()).then(|| file_comments.join("\n"));
+    pending.reverse();
+    let mut visited = 0usize;
+    while let Some((node, parent, owner)) = pending.pop() {
+        visited += 1;
+        if visited > 200_000
+            || (visited.is_multiple_of(1024) && started.elapsed() >= Duration::from_millis(500))
+        {
+            // 达到遍历预算时保留已经确认的健康声明，其余正文由上层按未覆盖区域退化。
+            output.has_errors = true;
+            break;
+        }
+        if node.is_error() || node.is_missing() || is_comment(node) {
+            continue;
+        }
+        if grammar == Grammar::Php && node.kind() == "text" {
+            // 只有 PHP grammar 的真实模板文本节点进入 HTML，字符串里的标签不能被重解析。
+            html_ranges.push(node.byte_range());
+        }
+        if is_import(grammar, node, source) {
+            if output.imports.len() < 128 {
+                output
+                    .imports
+                    .push(node_text(node, source).trim().to_string());
+            }
+            continue;
+        }
+        let mut child_parent = parent;
+        let specs = declarations(grammar, node, source, parent, &output);
+        for (name_node, kind, span, owns_children) in specs {
+            if name_node.has_error() || name_node.is_missing() {
+                continue;
+            }
+            let (name, declared_owner) = name_and_owner(name_node, source);
+            if name.trim().is_empty() {
+                continue;
+            }
+            let index = output.declarations.len();
+            output.declarations.push(Declaration {
+                name,
+                kind,
+                start_line: start_line(span),
+                end_line: end_line(span),
+                signature: signature(span, source),
+                doc_comment: adjacent_comments(span, source),
+                parent,
+                owner: declared_owner.or_else(|| parent.is_none().then(|| owner.clone()).flatten()),
+                is_test: false,
+            });
+            if owns_children {
+                child_parent = Some(index);
+            }
+        }
+        let mut cursor = node.walk();
+        let children: Vec<_> = node.named_children(&mut cursor).collect();
+        for child in children.into_iter().rev() {
+            if !is_comment(child)
+                && !child.is_error()
+                && !child.is_missing()
+                && is_region_parent(node.kind())
+            {
+                output.regions.push(StructuralRegion {
+                    start_line: start_line(child),
+                    end_line: end_line(child),
+                    parent: child_parent,
+                });
+            }
+            pending.push((child, child_parent, owner.clone()));
+        }
+    }
+    if !html_ranges.is_empty() {
+        let mut masked: Vec<_> = source
+            .bytes()
+            .map(|byte| match byte {
+                b'\n' | b'\r' => byte,
+                _ => b' ',
+            })
+            .collect();
+        for range in html_ranges {
+            masked[range.clone()].copy_from_slice(&bytes[range]);
+        }
+        let html = std::str::from_utf8(&masked).ok()?;
+        if let Some(parsed) = super::mixed::parse_html(html) {
+            super::mixed::merge(&mut output, parsed);
+        } else {
+            output.has_errors = true;
+        }
+    }
+    Some(output)
+}
+
+/// 一项声明为名字节点、类别、完整范围、是否构成词法所有者。
+type DeclSpec<'a> = (Node<'a>, SymbolKind, Node<'a>, bool);
+
+/// 依据各官方 grammar 的实际字段筛选声明，局部变量不会混入公共符号。
+fn declarations<'a>(
+    grammar: Grammar,
+    node: Node<'a>,
+    source: &str,
+    parent: Option<usize>,
+    output: &ParseOutput,
+) -> Vec<DeclSpec<'a>> {
+    use SymbolKind::{Constant, Enum, Function, Module, Other, Struct, Trait, TypeAlias};
+    let kind = node.kind();
+    let direct = match grammar {
+        Grammar::Java => match kind {
+            "class_declaration" | "record_declaration" => Some(Struct),
+            "interface_declaration" | "annotation_type_declaration" => Some(Trait),
+            "enum_declaration" => Some(Enum),
+            "method_declaration"
+            | "constructor_declaration"
+            | "compact_constructor_declaration"
+            | "annotation_type_element_declaration" => Some(Function),
+            "module_declaration" => Some(Module),
+            "enum_constant" => Some(Constant),
+            _ => None,
+        },
+        Grammar::Php => match kind {
+            "class_declaration" => Some(Struct),
+            "trait_declaration" | "interface_declaration" => Some(Trait),
+            "enum_declaration" => Some(Enum),
+            "function_definition" | "method_declaration" => Some(Function),
+            "namespace_definition" if node.child_by_field_name("body").is_some() => Some(Module),
+            "enum_case" => Some(Constant),
+            _ => None,
+        },
+        Grammar::C | Grammar::Cpp => match kind {
+            "class_specifier" | "struct_specifier" | "union_specifier"
+                if node.child_by_field_name("body").is_some() =>
+            {
+                Some(Struct)
+            }
+            "enum_specifier" if node.child_by_field_name("body").is_some() => Some(Enum),
+            "namespace_definition" => Some(Module),
+            "alias_declaration" => Some(TypeAlias),
+            "concept_definition" => Some(Trait),
+            "preproc_def" | "preproc_function_def" | "enumerator" => Some(Constant),
+            _ => None,
+        },
+        Grammar::CSharp => match kind {
+            "class_declaration" | "struct_declaration" | "record_declaration" => Some(Struct),
+            "interface_declaration" => Some(Trait),
+            "enum_declaration" => Some(Enum),
+            "method_declaration"
+            | "constructor_declaration"
+            | "destructor_declaration"
+            | "local_function_statement" => Some(Function),
+            "delegate_declaration" => Some(TypeAlias),
+            "namespace_declaration" => Some(Module),
+            "property_declaration" | "event_declaration" => Some(Other),
+            "enum_member_declaration" => Some(Constant),
+            _ => None,
+        },
+        Grammar::Ruby => match kind {
+            "class" => Some(Struct),
+            "module" => Some(Module),
+            "method" | "singleton_method" => Some(Function),
+            _ => None,
+        },
+        Grammar::Swift => match kind {
+            "class_declaration" => Some(
+                match node
+                    .child_by_field_name("declaration_kind")
+                    .map(|n| node_text(n, source))
+                {
+                    Some("enum") => Enum,
+                    Some("extension") => SymbolKind::Impl,
+                    _ => Struct,
+                },
+            ),
+            "protocol_declaration" => Some(Trait),
+            "function_declaration" | "protocol_function_declaration" | "init_declaration" => {
+                Some(Function)
+            }
+            "typealias_declaration" | "associatedtype_declaration" => Some(TypeAlias),
+            "enum_entry" => Some(Constant),
+            _ => None,
+        },
+        Grammar::Kotlin => match kind {
+            "class_declaration" | "object_declaration" => Some(Struct),
+            "function_declaration" => Some(Function),
+            _ => None,
+        },
+        Grammar::Bash | Grammar::Zsh | Grammar::Fish if kind == "function_definition" => {
+            Some(Function)
+        }
+        Grammar::Wit => match kind {
+            "world_item" => Some(Module),
+            "interface_item" => Some(Trait),
+            "record_item" | "resource_item" => Some(Struct),
+            "enum_item" | "variant_item" => Some(Enum),
+            "flags_item" | "type_item" => Some(TypeAlias),
+            "func_item" => Some(Function),
+            "enum_case" | "variant_case" | "flags_case" => Some(Constant),
+            "record_field" => Some(Other),
+            _ => None,
+        },
+        _ => None,
+    };
+    if let Some(symbol_kind) = direct {
+        return node
+            .child_by_field_name("name")
+            .map(|name| vec![(name, symbol_kind, declaration_span(node), true)])
+            .unwrap_or_default();
+    }
+    match grammar {
+        Grammar::Java if matches!(kind, "field_declaration" | "constant_declaration") => {
+            field_children(node, "declarator")
+                .into_iter()
+                .filter_map(|child| {
+                    child.child_by_field_name("name").map(|name| {
+                        (
+                            name,
+                            if kind == "constant_declaration" {
+                                Constant
+                            } else {
+                                Other
+                            },
+                            node,
+                            false,
+                        )
+                    })
+                })
+                .collect()
+        }
+        Grammar::Php if matches!(kind, "const_declaration" | "property_declaration") => {
+            let mut cursor = node.walk();
+            node.named_children(&mut cursor)
+                .filter_map(|child| match child.kind() {
+                    "const_element" => {
+                        named_child_kind(child, "name").map(|name| (name, Constant, node, false))
+                    }
+                    "property_element" => child
+                        .child_by_field_name("name")
+                        .map(|name| (name, Other, node, false)),
+                    _ => None,
+                })
+                .collect()
+        }
+        Grammar::C | Grammar::Cpp if kind == "function_definition" => node
+            .child_by_field_name("declarator")
+            .and_then(declarator_name)
+            .map(|(name, _)| vec![(name, Function, declaration_span(node), true)])
+            .unwrap_or_default(),
+        Grammar::C | Grammar::Cpp
+            if matches!(
+                kind,
+                "declaration" | "field_declaration" | "type_definition"
+            ) =>
+        {
+            let in_function = parent
+                .and_then(|i| output.declarations.get(i))
+                .is_some_and(|d| d.kind == Function);
+            if in_function && kind != "type_definition" {
+                return Vec::new();
+            }
+            field_children(node, "declarator")
+                .into_iter()
+                .filter_map(|child| {
+                    declarator_name(child).map(|(name, function)| {
+                        (
+                            name,
+                            if kind == "type_definition" {
+                                TypeAlias
+                            } else if function {
+                                Function
+                            } else {
+                                Other
+                            },
+                            declaration_span(node),
+                            false,
+                        )
+                    })
+                })
+                .collect()
+        }
+        Grammar::CSharp if matches!(kind, "field_declaration" | "event_field_declaration") => {
+            let Some(variables) = named_child_kind(node, "variable_declaration") else {
+                return Vec::new();
+            };
+            let mut cursor = variables.walk();
+            variables
+                .named_children(&mut cursor)
+                .filter(|child| child.kind() == "variable_declarator")
+                .filter_map(|child| {
+                    child
+                        .child_by_field_name("name")
+                        .map(|name| (name, Other, node, false))
+                })
+                .collect()
+        }
+        Grammar::CSharp if kind == "operator_declaration" => node
+            .child_by_field_name("operator")
+            .map(|name| vec![(name, Function, node, true)])
+            .unwrap_or_default(),
+        Grammar::Ruby if kind == "assignment" => node
+            .child_by_field_name("left")
+            .filter(|name| matches!(name.kind(), "constant" | "scope_resolution"))
+            .map(|name| vec![(name, Constant, node, false)])
+            .unwrap_or_default(),
+        Grammar::Swift
+            if matches!(
+                kind,
+                "property_declaration" | "protocol_property_declaration"
+            ) =>
+        {
+            if parent
+                .and_then(|i| output.declarations.get(i))
+                .is_some_and(|d| d.kind == Function)
+            {
+                return Vec::new();
+            }
+            let Some(pattern) = node.child_by_field_name("name") else {
+                return Vec::new();
+            };
+            pattern_names(pattern, "simple_identifier")
+                .into_iter()
+                .map(|name| (name, Other, node, false))
+                .collect()
+        }
+        Grammar::Kotlin if kind == "property_declaration" => {
+            if parent
+                .and_then(|i| output.declarations.get(i))
+                .is_some_and(|d| d.kind == Function)
+            {
+                return Vec::new();
+            }
+            let mut cursor = node.walk();
+            node.named_children(&mut cursor)
+                .filter(|child| {
+                    matches!(
+                        child.kind(),
+                        "variable_declaration" | "multi_variable_declaration"
+                    )
+                })
+                .flat_map(|pattern| pattern_names(pattern, "identifier"))
+                .map(|name| (name, Other, node, false))
+                .collect()
+        }
+        Grammar::Make if kind == "rule" => {
+            // 静态模式规则使用 target 字段，普通规则把多个目标放在 targets 子节点。
+            node.child_by_field_name("target")
+                .or_else(|| named_child_kind(node, "targets"))
+                .map(|targets| {
+                    let mut cursor = targets.walk();
+                    targets
+                        .named_children(&mut cursor)
+                        .map(|name| (name, Function, node, false))
+                        .collect()
+                })
+                .unwrap_or_default()
+        }
+        Grammar::Make if matches!(kind, "variable_assignment" | "shell_assignment") => node
+            .child_by_field_name("name")
+            .map(|name| vec![(name, Other, node, false)])
+            .unwrap_or_default(),
+        Grammar::Just if kind == "recipe" => named_child_kind(node, "recipe_header")
+            .and_then(|header| header.child_by_field_name("name"))
+            .map(|name| vec![(name, Function, node, true)])
+            .unwrap_or_default(),
+        Grammar::Just if kind == "assignment" => node
+            .child_by_field_name("left")
+            .map(|name| vec![(name, Other, node, false)])
+            .unwrap_or_default(),
+        Grammar::Just if kind == "module" => node
+            .child_by_field_name("name")
+            .map(|name| vec![(name, Module, node, false)])
+            .unwrap_or_default(),
+        Grammar::Proto => {
+            let spec = match kind {
+                "message" => Some(("message_name", Struct)),
+                "enum" => Some(("enum_name", Enum)),
+                "service" => Some(("service_name", Trait)),
+                "rpc" => Some(("rpc_name", Function)),
+                "field" | "map_field" | "oneof_field" => Some(("identifier", Other)),
+                "enum_field" => Some(("identifier", Constant)),
+                _ => None,
+            };
+            spec.and_then(|(name_kind, symbol_kind)| {
+                named_child_kind(node, name_kind).map(|name| vec![(name, symbol_kind, node, true)])
+            })
+            .unwrap_or_default()
+        }
+        Grammar::Graphql => {
+            let spec = match kind {
+                "object_type_definition" | "input_object_type_definition" => Some(("name", Struct)),
+                "interface_type_definition" => Some(("name", Trait)),
+                "enum_type_definition" => Some(("name", Enum)),
+                "union_type_definition" | "scalar_type_definition" => Some(("name", TypeAlias)),
+                "operation_definition" | "directive_definition" => Some(("name", Function)),
+                "fragment_definition" => Some(("fragment_name", Function)),
+                "field_definition" | "input_value_definition" => Some(("name", Other)),
+                "enum_value_definition" => Some(("enum_value", Constant)),
+                _ => None,
+            };
+            spec.and_then(|(name_kind, symbol_kind)| {
+                named_child_kind(node, name_kind).map(|name| vec![(name, symbol_kind, node, true)])
+            })
+            .unwrap_or_default()
+        }
+        Grammar::Sql => {
+            let spec = match kind {
+                "create_table" | "create_view" | "create_materialized_view" => Some(Struct),
+                "create_function" | "create_trigger" => Some(Function),
+                "create_type" => Some(TypeAlias),
+                "create_database" | "create_schema" => Some(Module),
+                "create_index" | "create_sequence" => Some(Other),
+                _ => None,
+            };
+            spec.and_then(|symbol_kind| {
+                (if kind == "create_trigger" {
+                    name_after_keyword(node, "keyword_trigger")
+                } else {
+                    None
+                })
+                .or_else(|| node.child_by_field_name("name"))
+                .or_else(|| named_child_kind(node, "object_reference"))
+                .or_else(|| named_child_kind(node, "identifier"))
+                .map(|name| vec![(name, symbol_kind, node, true)])
+            })
+            .unwrap_or_default()
+        }
+        _ => {
+            let _ = source;
+            Vec::new()
+        }
+    }
+}
+
+/// 只沿 declarator 语法链解引用，绝不从参数或初始化表达式取第一个标识符。
+///
+/// 最靠近名字的有意义包装为 function_declarator 才是函数；`(*cb)(int)` 是变量。
+fn declarator_name(mut node: Node<'_>) -> Option<(Node<'_>, bool)> {
+    let mut function = false;
+    for _ in 0..64 {
+        match node.kind() {
+            "identifier"
+            | "field_identifier"
+            | "type_identifier"
+            | "qualified_identifier"
+            | "destructor_name"
+            | "operator_name"
+            | "template_function"
+            | "template_method" => return Some((node, function)),
+            "function_declarator" => function = true,
+            "pointer_declarator"
+            | "pointer_type_declarator"
+            | "reference_declarator"
+            | "array_declarator" => function = false,
+            _ => {}
+        }
+        if let Some(next) = node.child_by_field_name("declarator") {
+            node = next;
+            continue;
+        }
+        if matches!(
+            node.kind(),
+            "parenthesized_declarator" | "reference_declarator" | "attributed_declarator"
+        ) {
+            let mut cursor = node.walk();
+            node = node.named_children(&mut cursor).find(|child| {
+                child.kind().ends_with("declarator")
+                    || matches!(
+                        child.kind(),
+                        "identifier"
+                            | "field_identifier"
+                            | "type_identifier"
+                            | "qualified_identifier"
+                    )
+            })?;
+            continue;
+        }
+        return None;
+    }
+    None
+}
+
+/// 模板头属于声明范围；外层模板参数不能成为被索引的函数名。
+fn declaration_span(mut node: Node<'_>) -> Node<'_> {
+    while let Some(parent) = node
+        .parent()
+        .filter(|parent| parent.kind() == "template_declaration")
+    {
+        node = parent;
+    }
+    node
+}
+
+/// 非包围式命名空间作为 owner 保存，避免伪造覆盖整个文件的声明范围。
+fn detached_owner(grammar: Grammar, node: Node<'_>, source: &str) -> Option<String> {
+    let name = match (grammar, node.kind()) {
+        (Grammar::Java, "package_declaration") => named_child_kind(node, "scoped_identifier")
+            .or_else(|| named_child_kind(node, "identifier")),
+        (Grammar::Php, "namespace_definition") if node.child_by_field_name("body").is_none() => {
+            node.child_by_field_name("name")
+        }
+        (Grammar::CSharp, "file_scoped_namespace_declaration") => node.child_by_field_name("name"),
+        (Grammar::Kotlin, "package_header") => named_child_kind(node, "qualified_identifier"),
+        _ => None,
+    }?;
+    Some(node_text(name, source).to_string())
+}
+
+/// 返回语法中的导入或依赖节点，保留原句以免损失别名与条件。
+fn is_import(grammar: Grammar, node: Node<'_>, source: &str) -> bool {
+    let kind = node.kind();
+    match grammar {
+        Grammar::Java => kind == "import_declaration",
+        Grammar::Php => matches!(
+            kind,
+            "namespace_use_declaration"
+                | "use_declaration"
+                | "include_expression"
+                | "include_once_expression"
+                | "require_expression"
+                | "require_once_expression"
+        ),
+        Grammar::C | Grammar::Cpp => matches!(kind, "preproc_include" | "using_declaration"),
+        Grammar::CSharp => kind == "using_directive",
+        Grammar::Swift => kind == "import_declaration",
+        Grammar::Kotlin | Grammar::Proto | Grammar::Just => kind == "import",
+        Grammar::Make => kind == "include_directive",
+        Grammar::Wit => matches!(kind, "use_item" | "include_item" | "import_item"),
+        Grammar::Ruby if kind == "call" && node.child_by_field_name("receiver").is_none() => {
+            node.child_by_field_name("method").is_some_and(|method| {
+                matches!(
+                    node_text(method, source),
+                    "require" | "require_relative" | "load"
+                )
+            })
+        }
+        Grammar::Bash | Grammar::Zsh | Grammar::Fish if kind == "command" => node
+            .child_by_field_name("name")
+            .is_some_and(|name| matches!(node_text(name, source), "source" | ".")),
+        _ => false,
+    }
+}
+
+/// C++ 类外定义的限定名前缀保留为 owner，限定名来自语法字段。
+fn name_and_owner(mut node: Node<'_>, source: &str) -> (String, Option<String>) {
+    let mut owners = Vec::new();
+    while node.kind() == "qualified_identifier" {
+        let Some(name) = node.child_by_field_name("name") else {
+            break;
+        };
+        if let Some(scope) = node.child_by_field_name("scope") {
+            owners.push(node_text(scope, source).to_string());
+        }
+        node = name;
+    }
+    (
+        node_text(node, source).to_string(),
+        (!owners.is_empty()).then(|| owners.join("::")),
+    )
+}
+
+/// 获取重复字段对应的所有节点，例如一条声明内的多个字段。
+fn field_children<'a>(node: Node<'a>, field: &str) -> Vec<Node<'a>> {
+    let mut cursor = node.walk();
+    node.children_by_field_name(field, &mut cursor).collect()
+}
+
+/// 根据官方 AST 子节点种类取直接孩子，不跨进嵌套表达式。
+fn named_child_kind<'a>(node: Node<'a>, kind: &str) -> Option<Node<'a>> {
+    let mut cursor = node.walk();
+    let found = node
+        .named_children(&mut cursor)
+        .find(|child| child.kind() == kind);
+    found
+}
+
+/// 正文起点由 AST 字段给出，字符串和注释中的花括号不会截断签名。
+fn signature(node: Node<'_>, source: &str) -> Option<String> {
+    let body_owner = if node.kind() == "template_declaration" {
+        let mut cursor = node.walk();
+        let found = node
+            .named_children(&mut cursor)
+            .find(|child| {
+                matches!(
+                    child.kind(),
+                    "function_definition" | "class_specifier" | "struct_specifier"
+                )
+            })
+            .unwrap_or(node);
+        found
+    } else {
+        node
+    };
+    let end = body_owner
+        .child_by_field_name("body")
+        .or_else(|| body_owner.child_by_field_name("accessors"))
+        .or_else(|| named_child_kind(body_owner, "function_body"))
+        .or_else(|| named_child_kind(body_owner, "class_body"))
+        .map_or(node.end_byte(), |body| body.start_byte());
+    let text = source
+        .get(node.start_byte()..end)?
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ");
+    (!text.is_empty()).then(|| text.chars().take(240).collect())
+}
+
+/// 仅合并 AST 中相邻的注释兄弟，空两行或其他语句会中断归属。
+fn adjacent_comments(node: Node<'_>, source: &str) -> Option<String> {
+    let mut parts = Vec::new();
+    let mut start = node.start_position().row;
+    let mut previous = node.prev_named_sibling();
+    while let Some(comment) = previous.filter(|comment| is_comment(*comment)) {
+        if start.saturating_sub(comment.end_position().row) > 2 {
+            break;
+        }
+        parts.push(node_text(comment, source));
+        start = comment.start_position().row;
+        previous = comment.prev_named_sibling();
+    }
+    parts.reverse();
+    (!parts.is_empty()).then(|| parts.join("\n").chars().take(600).collect())
+}
+
+/// 只认 grammar 命名注释节点，不扫描源码前缀。
+fn is_comment(node: Node<'_>) -> bool {
+    matches!(
+        node.kind(),
+        "comment" | "line_comment" | "block_comment" | "multiline_comment"
+    )
+}
+
+/// 只走模式子树提取多重绑定名，遇到类型与默认值不继续深入。
+fn pattern_names<'a>(node: Node<'a>, name_kind: &str) -> Vec<Node<'a>> {
+    if node.kind() == name_kind {
+        return vec![node];
+    }
+    if !matches!(
+        node.kind(),
+        "pattern" | "tuple_pattern" | "variable_declaration" | "multi_variable_declaration"
+    ) {
+        return Vec::new();
+    }
+    let mut cursor = node.walk();
+    node.named_children(&mut cursor)
+        .flat_map(|child| pattern_names(child, name_kind))
+        .collect()
+}
+
+/// 语法容器的直接孩子是可切块的语义边界，表达式内名字不单独形成检索块。
+fn is_region_parent(kind: &str) -> bool {
+    matches!(
+        kind,
+        "block"
+            | "compound_statement"
+            | "body_statement"
+            | "class_body"
+            | "declaration_list"
+            | "field_declaration_list"
+            | "statements"
+            | "function_body"
+            | "enum_body"
+            | "object"
+            | "array"
+            | "table"
+            | "table_array_element"
+            | "block_mapping"
+            | "block_sequence"
+            | "flow_mapping"
+            | "flow_sequence"
+            | "element"
+            | "message_body"
+            | "fields_definition"
+            | "input_fields_definition"
+            | "selection_set"
+            | "recipe"
+            | "document"
+            | "stream"
+            | "interface_items"
+            | "world_items"
+    )
+}
+
+/// SQL 缺少 name 字段的语句按 AST 关键字后的节点定位名字，避开后方引用对象。
+fn name_after_keyword<'a>(node: Node<'a>, keyword: &str) -> Option<Node<'a>> {
+    let mut cursor = node.walk();
+    let keyword_node = node
+        .named_children(&mut cursor)
+        .find(|child| child.kind() == keyword)?;
+    keyword_node
+        .next_named_sibling()
+        .filter(|name| matches!(name.kind(), "identifier" | "object_reference"))
+}
+
+/// 以解析器字节范围读取原始源码，非法范围返回空串以隔离异常。
+fn node_text<'a>(node: Node<'_>, source: &'a str) -> &'a str {
+    source.get(node.byte_range()).unwrap_or_default()
+}
+
+/// Tree-sitter 行位置从零开始，转成公开的一基行号。
+fn start_line(node: Node<'_>) -> u32 {
+    u32::try_from(node.start_position().row + 1).unwrap_or(u32::MAX)
+}
+
+/// 末位置为半开区间；位于下一行首时不把下一行计入声明正文。
+fn end_line(node: Node<'_>) -> u32 {
+    let end = node.end_position();
+    u32::try_from(end.row + usize::from(end.column != 0))
+        .unwrap_or(u32::MAX)
+        .max(start_line(node))
+}
+
+/// 按真实扩展名与特殊文件名选择语法，Shell 和纯文本标签不会掩盖其实际方言。
+///
+/// 返回结构化声明与区域；未知纯文本、超出资源限制或语法运行时拒绝时返回 None。
+pub(super) fn parse(file_path: &str, language: Language, source: &str) -> Option<ParseOutput> {
+    let name = file_path
+        .rsplit('/')
+        .next()
+        .unwrap_or(file_path)
+        .to_ascii_lowercase();
+    let extension = name.rsplit_once('.').map(|(_, extension)| extension);
+    let grammar = match language {
+        Language::Java => Grammar::Java,
+        Language::Php => Grammar::Php,
+        Language::C => Grammar::C,
+        Language::Cpp => Grammar::Cpp,
+        Language::CSharp => Grammar::CSharp,
+        Language::Ruby => Grammar::Ruby,
+        Language::Swift => Grammar::Swift,
+        Language::Kotlin => Grammar::Kotlin,
+        Language::Sql => Grammar::Sql,
+        Language::Toml => Grammar::Toml,
+        Language::Yaml => Grammar::Yaml,
+        Language::Html => Grammar::Html,
+        Language::Shell => match (name.as_str(), extension) {
+            ("makefile", _) => Grammar::Make,
+            ("dockerfile" | "containerfile", _) => Grammar::Dockerfile,
+            ("justfile", _) => Grammar::Just,
+            (_, Some("fish")) => Grammar::Fish,
+            (_, Some("zsh")) => Grammar::Zsh,
+            (_, Some("sh")) => shell_shebang(source).unwrap_or(Grammar::Bash),
+            (_, Some("bash")) => Grammar::Bash,
+            _ => return None,
+        },
+        Language::Text => match extension {
+            Some("wit") => Grammar::Wit,
+            Some("proto") => Grammar::Proto,
+            Some("graphql" | "gql") => Grammar::Graphql,
+            _ => return None,
+        },
+        _ => return None,
+    };
+    let output = parse_grammar(grammar, source)?;
+    if language == Language::C && extension == Some("h") && output.has_errors {
+        // .h 同时服务 C 与 C++；仅在 C 语法存在错误且 C++ 全树有效时采用 C++ AST。
+        // 选择依据是实际语法解析，不从类名、路径或项目名称猜测语言。
+        if let Some(cpp) = parse_grammar(Grammar::Cpp, source).filter(|cpp| !cpp.has_errors) {
+            return Some(cpp);
+        }
+    }
+    Some(output)
+}
+
+/// `.sh` 的显式解释器声明优先于默认 Bash，env 参数不会变成源码识别规则。
+fn shell_shebang(source: &str) -> Option<Grammar> {
+    let directive = source.lines().next()?.strip_prefix("#!")?;
+    directive
+        .split_whitespace()
+        .find_map(|part| match part.rsplit('/').next().unwrap_or(part) {
+            "fish" => Some(Grammar::Fish),
+            "zsh" => Some(Grammar::Zsh),
+            "bash" | "sh" => Some(Grammar::Bash),
+            _ => None,
+        })
+}
