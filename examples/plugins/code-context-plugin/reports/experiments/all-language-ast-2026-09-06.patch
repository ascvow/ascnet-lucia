+    let source = "<?php\nfunction serverTotal($value) { return $value + 1; }\n$example = '<script>function fake() { return 9; }</script>';\n?>\n<section>账目</section>\n<script>\nfunction clientTotal(value) {\n  return value + 2;\n}\n</script>\n";
+    let parsed = parse_path("ledger.php", source);
+    assert_eq!(parsed.tier, ParseTier::Structural);
+    assert!(!parsed.symbols.iter().any(|symbol| symbol.name == "fake"));
+    let server = parsed
+        .symbols
+        .iter()
+        .find(|symbol| symbol.name == "serverTotal")
+        .expect("PHP 服务逻辑");
+    assert_eq!((server.start_line, server.end_line), (2, 2));
+    let client = parsed
+        .symbols
+        .iter()
+        .find(|symbol| symbol.name == "clientTotal")
+        .expect("真实模板脚本");
+    assert_eq!((client.start_line, client.end_line), (7, 9));
+    assert!(parsed
+        .chunks
+        .iter()
+        .any(|chunk| chunk.symbol_name.as_deref() == Some("clientTotal")
+            && chunk.start_line == 7
+            && chunk.end_line == 9));
+}
