+                "include config.mk\n\nbuild test: source\n\tcompiler source\n",
+                "build",
+                None,
+            ),
+            (
+                Grammar::Proto,
+                "syntax = \"proto3\";\nmessage Request { int32 amount = 1; }\nservice Ledger {\n  rpc Total(Request) returns (Request);\n}\n",
+                "Total",
+                Some("Ledger"),
+            ),
+            (
+                Grammar::Graphql,
+                "type Ledger {\n  total: Int!\n}\n",
+                "total",
+                Some("Ledger"),
+            ),
+            (
+                Grammar::Wit,
+                "package example:ledger;\ninterface ledger {\n  total: func(value: u32) -> u32;\n}\n",
+                "total",
+                Some("ledger"),
+            ),
