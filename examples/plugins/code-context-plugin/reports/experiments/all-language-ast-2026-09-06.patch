+/// 从原样保留的 Just grammar 静态入口构建语言；ABI 兼容性仍由 Parser 验证。
+fn just_language() -> ts::Language {
+    unsafe extern "C" {
+        fn tree_sitter_just() -> *const ();
+    }
+    // 入口来自 build.rs 编译的固定官方 C grammar，生命周期覆盖整个进程。
+    unsafe { tree_sitter_language::LanguageFn::from_raw(tree_sitter_just).into() }
+}
