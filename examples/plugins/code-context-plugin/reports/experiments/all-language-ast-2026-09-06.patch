+//! 文档、样式和 JSONC 的成熟语法树适配。
+//!
+//! 这些语言主要提供无名区域；配置键、CSS 选择器和 Markdown 标题不会伪装成代码声明。
+//! 嵌入代码仅使用现有语言解析器，行号与父声明下标统一还原到外层文件。
+
+use super::{LineIndex, ParseOutput, StructuralRegion};
+use crate::repository::language::{self, Language, PathClass};
+use jsonc_parser::common::Ranged;
+use markdown::mdast::Node;
+use raffia::ast::{SimpleBlock, Statement};
+use raffia::Spanned;
+
+/// 遍历深度上限，避免异常嵌套耗尽 WASM 调用栈。
+const MAX_DOCUMENT_DEPTH: usize = 128;
+
+/// 样式 AST 的实际 WASI 栈预算；48 层在调试组件中已触发越界，32 层已实测通过。
+const MAX_STYLESHEET_DEPTH: usize = 32;
+
+/// 文档直接输入的字节上限，先于任何第三方递归解析和 AST 分配执行。
+const MAX_DOCUMENT_BYTES: usize = 4 * 1024 * 1024;
+
+/// 使用成熟 CSS 词法的嵌套块入口限深；引号和块注释中的括号不会影响预算。
+///
+/// 这只是一道资源限制，不接受或拒绝某种样式语法；具体语法仍由 Raffia 判定。
+fn stylesheet_tokens_within_budget(input: &mut cssparser::Parser<'_, '_>, depth: usize) -> bool {
+    while let Ok(token) = input.next_including_whitespace_and_comments() {
+        let nested = matches!(
+            token,
+            cssparser::Token::Function(_)
+                | cssparser::Token::ParenthesisBlock
+                | cssparser::Token::SquareBracketBlock
+                | cssparser::Token::CurlyBracketBlock
+        );
+        if nested {
+            if depth >= MAX_STYLESHEET_DEPTH {
+                return false;
+            }
+            let result: Result<(), cssparser::ParseError<'_, ()>> =
+                input.parse_nested_block(|child| {
+                    if stylesheet_tokens_within_budget(child, depth + 1) {
+                        Ok(())
+                    } else {
+                        Err(child.new_custom_error(()))
+                    }
+                });
+            if result.is_err() {
+                return false;
+            }
+        }
+    }
+    true
+}
+
+/// Sass 没有块括号，额外限制输入行的缩进层数；只用于资源拒绝，不生成声明或区域。
+///
+/// 注释中的异常深缩进也会被保守计入预算，通过该限制不表示 Sass 语法合法。
+fn sass_indentation_depth(source: &str) -> Option<usize> {
+    let mut levels = vec![0usize];
+    let mut maximum = 0usize;
+    for line in source.lines().filter(|line| !line.trim().is_empty()) {
+        let indentation = line
+            .bytes()
+            .take_while(|byte| matches!(byte, b' ' | b'\t'))
+            .fold(0usize, |width, byte| {
+                width + if byte == b'\t' { 4 } else { 1 }
+            });
+        while levels.last().is_some_and(|level| *level > indentation) {
+            levels.pop();
+        }
+        if levels.last().is_none_or(|level| *level < indentation) {
+            levels.push(indentation);
+        }
+        maximum = maximum.max(levels.len().saturating_sub(1));
+        if maximum > MAX_STYLESHEET_DEPTH {
+            return None;
+        }
+    }
+    Some(maximum)
+}
+
+/// 在进入 Raffia 前合并检查括号与缩进预算，防止小文件的合法深嵌套中止整个插件。
+fn stylesheet_within_budget(source: &str, syntax: raffia::Syntax) -> bool {
+    if source.len() > MAX_DOCUMENT_BYTES {
+        return false;
+    }
+    let indentation = if syntax == raffia::Syntax::Sass {
+        let Some(depth) = sass_indentation_depth(source) else {
+            return false;
+        };
+        depth
+    } else {
+        0
+    };
+    let mut input = cssparser::ParserInput::new(source);
+    stylesheet_tokens_within_budget(&mut cssparser::Parser::new(&mut input), indentation)
+}
+
+/// 依据真实文件方言分发文档解析；非本模块所有的语言返回 `None`。
+pub(super) fn parse(path: &str, language: Language, source: &str) -> Option<ParseOutput> {
+    if matches!(
+        language,
+        Language::Css | Language::Markdown | Language::Json
+    ) && source.len() > MAX_DOCUMENT_BYTES
+    {
+        return Some(ParseOutput {
+            has_errors: true,
+            ..ParseOutput::default()
+        });
+    }
+    let extension = path.rsplit('.').next().unwrap_or("").to_ascii_lowercase();
+    match language {
+        Language::Css => Some(parse_stylesheet(source, &extension)),
+        Language::Markdown => Some(parse_markdown(source, extension == "mdx")),
+        Language::Json => Some(parse_json(source, extension == "jsonc")),
+        _ => None,
+    }
+}
+
+/// 把合法半开字节区间变为原文件闭区间行号，不制造空区域。
+fn push_region(output: &mut ParseOutput, index: &LineIndex, start: usize, end: usize) {
+    if start < end {
+        output.regions.push(StructuralRegion {
+            start_line: index.line_of(start),
+            end_line: index.line_of(end - 1),
+            parent: None,
+        });
+    }
+}
+
+/// 使用 Raffia 分别解析 CSS、SCSS、缩进 Sass 和 Less；错误不冒充完整 AST。
+fn parse_stylesheet(source: &str, extension: &str) -> ParseOutput {
+    let syntax = match extension {
+        "scss" => raffia::Syntax::Scss,
+        "sass" => raffia::Syntax::Sass,
+        "less" => raffia::Syntax::Less,
+        _ => raffia::Syntax::Css,
+    };
+    if !stylesheet_within_budget(source, syntax) {
+        return ParseOutput {
+            has_errors: true,
+            ..ParseOutput::default()
+        };
+    }
+    let mut parser = raffia::Parser::new(source, syntax);
+    let mut output = ParseOutput {
+        file_doc: super::leading_doc_comment(source),
+        ..ParseOutput::default()
+    };
+    let Ok(stylesheet) = parser.parse::<raffia::ast::Stylesheet>() else {
+        output.has_errors = true;
+        return output;
+    };
+    output.has_errors = !parser.recoverable_errors().is_empty();
+    let index = LineIndex::new(source);
+    // Raffia 会剥离 BOM；字节位置必须补回，才能与原始文件的换行索引一致。
+    let bom = usize::from(source.starts_with('\u{feff}')) * 3;
+    collect_styles(&stylesheet.statements, &index, bom, 0, &mut output);
+    output
+}
+
+/// 遍历真实语句和所有承载子语句的块，不从标点或缩进重新猜测边界。
+fn collect_styles(
+    statements: &[Statement<'_>],
+    index: &LineIndex,
+    bom: usize,
+    depth: usize,
+    output: &mut ParseOutput,
+) {
+    if depth >= MAX_DOCUMENT_DEPTH {
+        output.has_errors = true;
+        return;
+    }
+    for statement in statements {
+        let span = statement.span();
+        push_region(output, index, span.start + bom, span.end + bom);
+        let mut blocks: Vec<&SimpleBlock<'_>> = Vec::new();
+        match statement {
+            Statement::AtRule(rule) => blocks.extend(rule.block.iter()),
+            Statement::QualifiedRule(rule) => blocks.push(&rule.block),
+            Statement::KeyframeBlock(rule) => blocks.push(&rule.block),
+            Statement::LessConditionalQualifiedRule(rule) => blocks.push(&rule.block),
+            Statement::LessMixinDefinition(rule) => blocks.push(&rule.block),
+            Statement::UnknownSassAtRule(rule) => blocks.extend(rule.block.iter()),
+            Statement::SassIfAtRule(rule) => {
+                blocks.push(&rule.if_clause.block);
+                blocks.extend(rule.else_if_clauses.iter().map(|clause| &clause.block));
+                blocks.extend(rule.else_clause.iter());
+            }
+            _ => {}
+        }
+        for block in blocks {
+            collect_styles(&block.statements, index, bom, depth + 1, output);
+        }
+    }
+}
+
+/// JSONC 只放宽注释和尾随逗号，不把 JSON5 的裸键、单引号或漏逗号误判为合法。
+fn parse_json(source: &str, jsonc: bool) -> ParseOutput {
+    let mut output = ParseOutput {
+        file_doc: super::leading_doc_comment(source),
+        ..ParseOutput::default()
+    };
+    let options = jsonc_parser::ParseOptions {
+        allow_comments: jsonc,
+        allow_trailing_commas: jsonc,
+        allow_loose_object_property_names: false,
+        allow_missing_commas: false,
+        allow_single_quoted_strings: false,
+        allow_hexadecimal_numbers: false,
+        allow_unary_plus_numbers: false,
+    };
+    match jsonc_parser::parse_to_ast(source, &Default::default(), &options) {
+        Ok(result) => {
+            if let Some(value) = result.value.as_ref() {
+                collect_json(value, &LineIndex::new(source), 0, &mut output);
+            } else {
+                output.has_errors = true;
+            }
+        }
+        Err(_) => output.has_errors = true,
+    }
+    output
+}
+
+/// 配置的对象属性和数组元素保留各自边界，嵌套过深时明确降级。
+fn collect_json(
+    value: &jsonc_parser::ast::Value<'_>,
+    index: &LineIndex,
+    depth: usize,
+    output: &mut ParseOutput,
+) {
+    if depth >= MAX_DOCUMENT_DEPTH {
+        output.has_errors = true;
+        return;
+    }
+    push_region(output, index, value.start(), value.end());
+    match value {
+        jsonc_parser::ast::Value::Object(object) => {
+            for property in &object.properties {
+                push_region(output, index, property.range.start, property.range.end);
+                collect_json(&property.value, index, depth + 1, output);
+            }
+        }
+        jsonc_parser::ast::Value::Array(array) => {
+            for element in &array.elements {
+                collect_json(element, index, depth + 1, output);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// 构建 MDX 的 JavaScript 校验回调，避免把大括号中的任意文本当作合法表达式。
+fn mdx_options() -> markdown::ParseOptions {
+    let mut options = markdown::ParseOptions::mdx();
+    options.mdx_esm_parse = Some(Box::new(|source| validate_mdx_js(source, false)));
+    options.mdx_expression_parse = Some(Box::new(|source, kind| {
+        if matches!(kind, markdown::MdxExpressionKind::AttributeExpression) {
+            validate_mdx_js(&format!("({{{source}}})"), true)
+        } else {
+            validate_mdx_js(source, true)
+        }
+    }));
+    options
+}
+
+/// Oxc 接收完整 ESM 或单个表达式；片段未闭合时允许 Markdown 继续收集后续行。
+fn validate_mdx_js(source: &str, expression: bool) -> markdown::MdxSignal {
+    let allocator = oxc_allocator::Allocator::default();
+    let source_type = oxc_span::SourceType::default()
+        .with_jsx(true)
+        .with_module(true);
+    let parser = oxc_parser::Parser::new(&allocator, source, source_type);
+    let valid = if expression {
+        // MDX 允许空表达式及纯注释表达式；先由 Oxc 确认它确实没有语句。
+        let empty = oxc_parser::Parser::new(&allocator, source, source_type).parse();
+        (!empty.diagnostics.has_errors() && empty.program.body.is_empty())
+            || parser.parse_expression().is_ok()
+    } else {
+        let parsed = parser.parse();
+        !parsed.panicked && !parsed.diagnostics.has_errors()
+    };
+    if valid {
+        markdown::MdxSignal::Ok
+    } else {
+        markdown::MdxSignal::Eof(
+            "MDX 内嵌 JavaScript 语法不完整或不合法".into(),
+            Box::new("lucia-code-context".into()),
+            Box::new("mdx-javascript".into()),
+        )
+    }
+}
+
+/// Markdown 与 MDX 分别启用对应语法，保留段落、代码块及实际嵌入代码的位置。
+fn parse_markdown(source: &str, mdx: bool) -> ParseOutput {
+    let mut options = if mdx {
+        mdx_options()
+    } else {
+        markdown::ParseOptions::gfm()
+    };
+    options.constructs.frontmatter = true;
+    let mut output = ParseOutput::default();
+    let Ok(root) = markdown::to_mdast(source, &options) else {
+        output.has_errors = true;
+        return output;
+    };
+    collect_markdown(&root, &LineIndex::new(source), 0, &mut output);
+    output
+}
+
+/// 合并嵌入解析结果；仅平移行号和已有父下标，不给代码添加虚构外层声明。
+fn append_embedded(output: &mut ParseOutput, parsed: Option<ParseOutput>, line_offset: u32) {
+    let Some(mut parsed) = parsed else {
+        output.has_errors = true;
+        return;
+    };
+    let declaration_offset = output.declarations.len();
+    for declaration in &mut parsed.declarations {
+        declaration.start_line = declaration.start_line.saturating_add(line_offset);
+        declaration.end_line = declaration.end_line.saturating_add(line_offset);
+        declaration.parent = declaration.parent.map(|parent| parent + declaration_offset);
+    }
+    for region in &mut parsed.regions {
+        region.start_line = region.start_line.saturating_add(line_offset);
+        region.end_line = region.end_line.saturating_add(line_offset);
+        region.parent = region.parent.map(|parent| parent + declaration_offset);
+    }
+    output.has_errors |= parsed.has_errors;
+    output.declarations.extend(parsed.declarations);
+    output.regions.extend(parsed.regions);
+    output.imports.extend(parsed.imports);
+}
+
+/// 提取真实 MDX 表达式中的嵌套函数；纯注释表达式没有代码声明。
+fn append_mdx_expression(output: &mut ParseOutput, source: &str, line_offset: u32, spread: bool) {
+    let allocator = oxc_allocator::Allocator::default();
+    let empty = oxc_parser::Parser::new(
+        &allocator,
+        source,
+        oxc_span::SourceType::default()
+            .with_jsx(true)
+            .with_module(true),
+    )
+    .parse();
+    if !empty.diagnostics.has_errors() && empty.program.body.is_empty() {
+        return;
+    }
+    let wrapped = if spread {
+        format!("({{{source}}})")
+    } else {
+        format!("({source})")
+    };
+    append_embedded(
+        output,
+        super::typescript::parse(&wrapped, false),
+        line_offset,
+    );
+}
+
+/// MDX 属性没有独立 position，使用解析器提供的原文映射还原回调函数的起始行。
+fn collect_mdx_attributes(
+    attributes: &[markdown::mdast::AttributeContent],
+    index: &LineIndex,
+    output: &mut ParseOutput,
+) {
+    use markdown::mdast::{AttributeContent, AttributeValue};
+    for attribute in attributes {
+        let (value, stops, spread) = match attribute {
+            AttributeContent::Expression(expression) => {
+                (&expression.value, &expression.stops, true)
+            }
+            AttributeContent::Property(property) => match &property.value {
+                Some(AttributeValue::Expression(expression)) => {
+                    (&expression.value, &expression.stops, false)
+                }
+                _ => continue,
+            },
+        };
+        if let Some((_, offset)) = stops.first() {
+            append_mdx_expression(
+                output,
+                value,
+                index.line_of(*offset).saturating_sub(1),
+                spread,
+            );
+        } else if !value.trim().is_empty() {
+            output.has_errors = true;
+        }
+    }
+}
+
+/// 使用文档围栏的通用语言别名，再复用仓库已有扩展名表，禁止业务词表参与。
+fn fenced_language(name: &str) -> Option<(String, Language)> {
+    let normalized = name.to_ascii_lowercase();
+    let extension = match normalized.as_str() {
+        "rust" => "rs",
+        "typescript" => "ts",
+        "javascript" => "js",
+        "python" => "py",
+        "ruby" => "rb",
+        "kotlin" => "kt",
+        "csharp" | "c#" => "cs",
+        "c++" => "cpp",
+        "shell" | "shellscript" => "sh",
+        "markdown" => "md",
+        "dockerfile" | "containerfile" | "makefile" | "justfile" => {
+            let PathClass::Indexable(language) = language::classify(&normalized) else {
+                return None;
+            };
+            return Some((normalized, language));
+        }
+        _ => normalized.as_str(),
+    };
+    let path = format!("embedded.{extension}");
+    let PathClass::Indexable(language) = language::classify(&path) else {
+        return None;
+    };
+    Some((path, language))
+}
+
+/// 遍历 mdast；文档结构由 Markdown 所有，嵌入的代码语法由各语言解析器所有。
+fn collect_markdown(node: &Node, index: &LineIndex, depth: usize, output: &mut ParseOutput) {
+    if depth >= MAX_DOCUMENT_DEPTH {
+        output.has_errors = true;
+        return;
+    }
+    if !matches!(node, Node::Root(_)) {
+        if let Some(position) = node.position() {
+            push_region(output, index, position.start.offset, position.end.offset);
+        }
+    }
+    let first_line = node
+        .position()
+        .map(|position| index.line_of(position.start.offset))
+        .unwrap_or(1);
+    match node {
+        Node::Code(code) => {
+            if let Some((path, language)) = code.lang.as_deref().and_then(fenced_language) {
+                // 文档语言的嵌套围栏保留为文档块，避免递归文档解析无限放大栈深度。
+                if language != Language::Markdown {
+                    append_embedded(
+                        output,
+                        super::parse_source(&path, language, &code.value),
+                        first_line,
+                    );
+                }
+            }
+        }
+        Node::MdxjsEsm(esm) => append_embedded(
+            output,
+            super::typescript::parse(&esm.value, false),
+            first_line.saturating_sub(1),
+        ),
+        Node::MdxFlowExpression(expression) => append_mdx_expression(
+            output,
+            &expression.value,
+            first_line.saturating_sub(1),
+            false,
+        ),
+        Node::MdxTextExpression(expression) => append_mdx_expression(
+            output,
+            &expression.value,
+            first_line.saturating_sub(1),
+            false,
+        ),
+        Node::MdxJsxFlowElement(element) => {
+            collect_mdx_attributes(&element.attributes, index, output)
+        }
+        Node::MdxJsxTextElement(element) => {
+            collect_mdx_attributes(&element.attributes, index, output)
+        }
+        Node::Html(html) => append_embedded(
+            output,
+            super::parse_source("embedded.html", Language::Html, &html.value),
+            first_line.saturating_sub(1),
+        ),
+        Node::Yaml(yaml) => append_embedded(
+            output,
+            super::parse_source("embedded.yaml", Language::Yaml, &yaml.value),
+            first_line,
+        ),
+        Node::Toml(toml) => append_embedded(
+            output,
+            super::parse_source("embedded.toml", Language::Toml, &toml.value),
+            first_line,
+        ),
+        _ => {}
+    }
+    if let Some(children) = node.children() {
+        for child in children {
+            collect_markdown(child, index, depth + 1, output);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 四种样式方言都必须得到原文件中的嵌套声明边界，不能靠 CSS grammar 误接收。
+    #[test]
+    fn stylesheet_dialects_retain_nested_regions() {
+        for (extension, source) in [
+            ("css", "/* 中文样式 */\n.panel {\n color: red;\n}\n"),
+            ("scss", "$color: red;\n.panel {\n color: $color;\n}\n"),
+            ("sass", "$color: red\n.panel\n  color: $color\n"),
+            ("less", "@color: red;\n.panel {\n color: @color;\n}\n"),
+        ] {
+            let parsed = parse_stylesheet(source, extension);
+            assert!(!parsed.has_errors, "{extension}");
+            assert!(parsed.declarations.is_empty(), "{extension}");
+            assert!(
+                parsed.regions.iter().any(|region| region.start_line == 3),
+                "{extension}"
+            );
+        }
+    }
+
+    /// 小型深嵌套输入必须在构建 AST 前降级，字符串与块注释中的括号不能误触发。
+    #[test]
+    fn stylesheet_depth_is_limited_before_recursive_parse() {
+        for extension in ["css", "scss", "less"] {
+            let nested = format!("{}color:red;{}", ".panel{".repeat(256), "}".repeat(256));
+            let parsed = parse_stylesheet(&nested, extension);
+            assert!(parsed.has_errors, "{extension}");
+            assert!(parsed.regions.is_empty());
+        }
+        let sass = (0..256)
+            .map(|depth| format!("{}.panel\n", " ".repeat(depth)))
+            .collect::<String>();
+        assert!(parse_stylesheet(&sass, "sass").has_errors);
+        let quoted = format!(
+            ".panel {{ content: \"{}\"; /* {} */ }}",
+            "(".repeat(256),
+            "{".repeat(256)
+        );
+        assert!(!parse_stylesheet(&quoted, "scss").has_errors);
+        let shallow = format!("{}color:red;{}", ".panel{".repeat(16), "}".repeat(16));
+        assert!(!parse_stylesheet(&shallow, "scss").has_errors);
+    }
+
+    /// 四 MiB 预算必须先于外部文档解析器，以免直接调用绕过文件读取上限。
+    #[test]
+    fn oversized_documents_skip_all_ast_allocation() {
+        let source = "a".repeat(MAX_DOCUMENT_BYTES + 1);
+        for (path, language) in [
+            ("style.css", Language::Css),
+            ("doc.mdx", Language::Markdown),
+            ("data.json", Language::Json),
+        ] {
+            let output = parse(path, language, &source).unwrap();
+            assert!(output.has_errors);
+            assert!(output.regions.is_empty());
+        }
+    }
+
+    /// JSONC 可以包含注释和尾逗号，JSON5 扩展和缺失逗号仍必须标记错误。
+    #[test]
+    fn jsonc_accepts_only_its_own_extensions() {
+        let parsed = parse_json("{\n // 中文配置\n \"name\": [1, 2,],\n}\n", true);
+        assert!(!parsed.has_errors);
+        assert!(parsed.declarations.is_empty());
+        assert!(parsed.regions.iter().any(|region| region.start_line == 3));
+        for invalid in [
+            "{name:1}",
+            "{'name':1}",
+            "{\"a\":1 \"b\":2}",
+            "{\"a\":0xff}",
+        ] {
+            assert!(parse_json(invalid, true).has_errors, "{invalid}");
+        }
+    }
+
+    /// 严格 JSON 不接受 JSONC 扩展、空文档和多根值，文件后缀决定语法契约。
+    #[test]
+    fn strict_json_rejects_extensions_and_missing_root() {
+        for invalid in ["", " // 注释", "{\"a\":1,}", "{/* 注释 */\"a\":1}", "{} {}"] {
+            let parsed = parse("settings.json", Language::Json, invalid).unwrap();
+            assert!(parsed.has_errors, "{invalid}");
+        }
+        for valid in ["{}", "[]", "{\"a\": [1, 2]}", "null"] {
+            assert!(
+                !parse("settings.json", Language::Json, valid)
+                    .unwrap()
+                    .has_errors,
+                "{valid}"
+            );
+        }
+        assert!(
+            !parse("settings.jsonc", Language::Json, "{/* 注释 */\"a\":1,}")
+                .unwrap()
+                .has_errors
+        );
+    }
+
+    /// Markdown 围栏中的声明行号必须还原到文档，并保留未知围栏的普通文本。
+    #[test]
+    fn markdown_fences_restore_declaration_lines() {
+        let source = "# 标题\n\n\u{60}\u{60}\u{60}typescript\nexport function total(n: number) {\n return n + 1;\n}\n\u{60}\u{60}\u{60}\n\n\u{60}\u{60}\u{60}unknown\n内容\n\u{60}\u{60}\u{60}\n";
+        let parsed = parse_markdown(source, false);
+        assert!(!parsed.has_errors);
+        let declaration = parsed
+            .declarations
+            .iter()
+            .find(|item| item.name == "total")
+            .unwrap();
+        assert_eq!((declaration.start_line, declaration.end_line), (4, 6));
+    }
+
+    /// MDX 的 Markdown 子内容不必符合 JSX，但真实嵌入 JavaScript 必须合法。
+    #[test]
+    fn mdx_validates_javascript_and_keeps_mixed_prose() {
+        let source = "export function total(n) { return n + 1; }\n\n<Panel value={total(1)}>\n\n# 中文标题\n\n</Panel>\n";
+        let parsed = parse_markdown(source, true);
+        assert!(!parsed.has_errors);
+        assert!(parsed
+            .declarations
+            .iter()
+            .any(|item| item.name == "total" && item.start_line == 1));
+        assert!(parse_markdown("<Panel value={a +} />", true).has_errors);
+        assert!(!parse_markdown("{/* 中文注释 */}", true).has_errors);
+    }
+
+    /// 错误不得标为完整解析，Unicode 与 BOM 不得使区域越过真实行号。
+    #[test]
+    fn malformed_and_unicode_documents_are_reported_truthfully() {
+        assert!(parse_stylesheet(".panel { color:", "css").has_errors);
+        let parsed = parse_stylesheet("\u{feff}/* 中文 */\n.面板 {\n color: red;\n}\n", "css");
+        assert!(!parsed.has_errors);
+        assert!(parsed
+            .regions
+            .iter()
+            .any(|region| region.start_line == 3 && region.end_line == 3));
+    }
+}
