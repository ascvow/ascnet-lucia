+/// 经由真实工具路由推进增量索引，返回最终检索正文与宿主可见状态。
+///
+/// 同一个 Host 保留插件实例和索引；索引预算耗尽只允许按正式协议继续调用，不能改 Host 限额。
+async fn search_after_index(
+    host: &impl AgentExtension,
+    label: &str,
+    args: Value,
+) -> (Value, Value) {
+    for attempt in 0..128 {
+        let result = AgentExtension::call_tool(
+            host,
+            ToolCall::new(format!("{label}-{attempt}"), TOOL_NAME, args.clone()),
+        )
+        .await
+        .expect("真实 WASM 工具调用成功")
+        .expect("Host 必须路由到 code_search");
+        let details = result.details.expect("检索必须报告真实状态");
+        if details["status"] != "indexing" {
+            assert!(!result.is_error, "{label} 发生插件错误：{}", result.content);
+            // 验收日志保留真实输入与结果，便于复核源码位置，不能只留下测试名称通过。
+            println!(
+                "WASM检索证据 {}",
+                json!({"tool": TOOL_NAME, "query": args["query"], "path_scope": args["path_scope"], "content": result.content, "details": details})
+            );
+            return (result.content, details);
+        }
+    }
+    panic!("{label} 超过索引推进预算");
+}
