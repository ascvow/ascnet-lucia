+/// 记录原始字符坐标对应的 AST 区域，不向符号表加入匿名节点。
+fn push_region(
+    start: usize,
+    end: usize,
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    output.regions.push(StructuralRegion {
+        start_line: index.line_of(start),
+        end_line: index.line_of(end).max(index.line_of(start)),
+        parent,
+    });
+}
