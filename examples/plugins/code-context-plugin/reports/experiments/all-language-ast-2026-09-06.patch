+//! 将固定的官方 Just grammar 与插件一起编译，避免引入第二套 Tree-sitter 运行时。
+
+/// 编译 vendor 中原样保留的 C grammar；目标工具链由 cc 的标准环境变量选择。
+fn main() {
+    let source = "vendor/tree-sitter-just/src";
+    cc::Build::new()
+        .std("c11")
+        .include(source)
+        .file(format!("{source}/parser.c"))
+        .file(format!("{source}/scanner.c"))
+        .compile("lucia-tree-sitter-just");
+    println!("cargo:rerun-if-changed={source}");
+}
