+/// 函数类型的泛型参数、参数及返回字段可能包含内联结构或函数表达式。
+fn walk_function_type(
+    node: &ast::FuncType,
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    for fields in [&node.typ_params.list, &node.params.list, &node.result.list] {
+        walk_fields(fields, parent, index, output);
+    }
+}
