+/// 遍历全部 Go 语句变体，局部显式声明复用顶层逻辑，短变量和临时表达式只提供范围。
+fn walk_statement(
+    node: &ast::Statement,
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    if let Some((start, end)) = statement_bounds(node) {
+        push_region(start, end, parent, index, output);
+    }
+    match node {
+        ast::Statement::Declaration(declaration) => match declaration {
+            ast::DeclStmt::Type(node) => {
+                for spec in &node.specs {
+                    walk_type(spec, parent, index, output);
+                }
+            }
+            ast::DeclStmt::Const(node) => {
+                for spec in &node.specs {
+                    walk_values(
+                        &spec.name,
+                        spec.typ.as_ref(),
+                        &spec.values,
+                        &spec.docs,
+                        parent,
+                        index,
+                        output,
+                    );
+                }
+            }
+            ast::DeclStmt::Variable(node) => {
+                for spec in &node.specs {
+                    walk_values(
+                        &spec.name,
+                        spec.typ.as_ref(),
+                        &spec.values,
+                        &spec.docs,
+                        parent,
+                        index,
+                        output,
+                    );
+                }
+            }
+        },
+        ast::Statement::Block(node) => walk_block(node, parent, index, output),
+        ast::Statement::If(node) => {
+            if let Some(init) = &node.init {
+                walk_statement(init, parent, index, output);
+            }
+            walk_expression(&node.cond, parent, index, output);
+            walk_block(&node.body, parent, index, output);
+            if let Some(alternate) = &node.else_ {
+                walk_statement(alternate, parent, index, output);
+            }
+        }
+        ast::Statement::For(node) => {
+            for statement in [&node.init, &node.cond, &node.post].into_iter().flatten() {
+                walk_statement(statement, parent, index, output);
+            }
+            walk_block(&node.body, parent, index, output);
+        }
+        ast::Statement::Range(node) => {
+            for expression in node
+                .key
+                .iter()
+                .chain(&node.value)
+                .chain(std::iter::once(&node.expr))
+            {
+                walk_expression(expression, parent, index, output);
+            }
+            walk_block(&node.body, parent, index, output);
+        }
+        ast::Statement::Expr(node) => walk_expression(&node.expr, parent, index, output),
+        ast::Statement::Assign(node) => {
+            for expression in node.left.iter().chain(&node.right) {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Statement::Return(node) => {
+            for expression in &node.ret {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Statement::Go(node) => walk_call(&node.call, parent, index, output),
+        ast::Statement::Defer(node) => walk_call(&node.call, parent, index, output),
+        ast::Statement::Label(node) => walk_statement(&node.stmt, parent, index, output),
+        ast::Statement::Send(node) => {
+            walk_expression(&node.chan, parent, index, output);
+            walk_expression(&node.value, parent, index, output);
+        }
+        ast::Statement::IncDec(node) => walk_expression(&node.expr, parent, index, output),
+        ast::Statement::Switch(node) => {
+            if let Some(init) = &node.init {
+                walk_statement(init, parent, index, output);
+            }
+            if let Some(tag) = &node.tag {
+                walk_expression(tag, parent, index, output);
+            }
+            walk_cases(&node.block, parent, index, output);
+        }
+        ast::Statement::TypeSwitch(node) => {
+            for statement in node.init.iter().chain(&node.tag) {
+                walk_statement(statement, parent, index, output);
+            }
+            walk_cases(&node.block, parent, index, output);
+        }
+        ast::Statement::Select(node) => {
+            for clause in &node.body.body {
+                push_region(clause.pos.0, clause.pos.1, parent, index, output);
+                if let Some(comm) = &clause.comm {
+                    walk_statement(comm, parent, index, output);
+                }
+                for statement in clause.body.iter() {
+                    walk_statement(statement, parent, index, output);
+                }
+            }
+        }
+        ast::Statement::Branch(_) | ast::Statement::Empty(_) => {}
+    }
+}
