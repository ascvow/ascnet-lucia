+/// 遍历表达式中真实的函数体、容器和字段；名称只有显式声明节点才能创建。
+fn walk_expression(
+    node: &ast::Expression,
+    parent: Option<usize>,
+    index: &GoLineIndex,
+    output: &mut ParseOutput,
+) {
+    let start = expression_start(node);
+    let end = expression_end(node);
+    if index.line_of(start) < index.line_of(end) {
+        push_region(start, end, parent, index, output);
+    }
+    match node {
+        ast::Expression::Call(node) => walk_call(node, parent, index, output),
+        ast::Expression::Index(node) => {
+            walk_expression(&node.left, parent, index, output);
+            walk_expression(&node.index, parent, index, output);
+        }
+        ast::Expression::IndexList(node) => {
+            walk_expression(&node.left, parent, index, output);
+            for expression in &node.indices {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Expression::Slice(node) => {
+            walk_expression(&node.left, parent, index, output);
+            for expression in node.index.iter().flatten() {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Expression::FuncLit(node) => {
+            walk_function_type(&node.typ, parent, index, output);
+            walk_block(&node.body, parent, index, output);
+        }
+        ast::Expression::Ellipsis(node) => {
+            if let Some(expression) = &node.elt {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Expression::Selector(node) => walk_expression(&node.x, parent, index, output),
+        ast::Expression::Range(node) => walk_expression(&node.right, parent, index, output),
+        ast::Expression::Star(node) => walk_expression(&node.right, parent, index, output),
+        ast::Expression::Paren(node) => walk_expression(&node.expr, parent, index, output),
+        ast::Expression::TypeAssert(node) => {
+            walk_expression(&node.left, parent, index, output);
+            if let Some(expression) = &node.right {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Expression::CompositeLit(node) => {
+            walk_expression(&node.typ, parent, index, output);
+            walk_literal(&node.val, parent, index, output);
+        }
+        ast::Expression::List(nodes) => {
+            for expression in nodes {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Expression::Operation(node) => {
+            walk_expression(&node.x, parent, index, output);
+            if let Some(expression) = &node.y {
+                walk_expression(expression, parent, index, output);
+            }
+        }
+        ast::Expression::TypeMap(node) => {
+            walk_expression(&node.key, parent, index, output);
+            walk_expression(&node.val, parent, index, output);
+        }
+        ast::Expression::TypeArray(node) => {
+            walk_expression(&node.len, parent, index, output);
+            walk_expression(&node.typ, parent, index, output);
+        }
+        ast::Expression::TypeSlice(node) => walk_expression(&node.typ, parent, index, output),
+        ast::Expression::TypeFunction(node) => walk_function_type(node, parent, index, output),
+        ast::Expression::TypeStruct(node) => walk_fields(&node.fields, parent, index, output),
+        ast::Expression::TypeInterface(node) => {
+            walk_fields(&node.methods.list, parent, index, output)
+        }
+        ast::Expression::TypeChannel(node) => walk_expression(&node.typ, parent, index, output),
+        ast::Expression::TypePointer(node) => walk_expression(&node.typ, parent, index, output),
+        ast::Expression::Ident(_) | ast::Expression::BasicLit(_) => {}
+    }
+}
