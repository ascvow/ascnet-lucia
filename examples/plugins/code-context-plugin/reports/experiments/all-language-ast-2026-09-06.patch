+//! 按索引白名单逐扩展名验证完整解析链，不以加载 grammar 或返回文件路径替代源码覆盖。
+
+use super::{parse_file, ParseTier, ParsedFile};
+use crate::model::{RepositoryIdentity, SymbolKind};
+use crate::repository::language::{classify, PathClass};
+use std::collections::BTreeSet;
+
+/// 一组共用语法的真实源码；声明锚点同时冻结短名、首行和闭区间末行。
+struct Fixture {
+    paths: &'static [&'static str],
+    source: &'static str,
+    declaration: Option<(&'static str, u32, u32)>,
+    body: &'static str,
+    text: bool,
+}
+
+/// 从真实路径分类入口解析，保证声明标签与扩展名路由不会互相脱节。
+fn parse_path(path: &str, source: &str) -> ParsedFile {
+    let PathClass::Indexable(language) = classify(path) else {
+        panic!("白名单路径未进入索引：{path}");
+    };
+    let repository = RepositoryIdentity::from_workspace_root("/language-matrix").expect("测试身份");
+    parse_file(&repository, path, language, source)
+}
+
+/// 检查真实符号与正文范围；没有声明的结构格式不能被伪装成函数。
+fn verify(path: &str, fixture: &Fixture) {
+    let parsed = parse_path(path, fixture.source);
+    assert_eq!(
+        parsed.tier,
+        if fixture.text {
+            ParseTier::Text
+        } else {
+            ParseTier::Structural
+        },
+        "{path}"
+    );
+    let lines: Vec<_> = fixture.source.lines().collect();
+    let body_line = lines
+        .iter()
+        .position(|line| line.contains(fixture.body))
+        .expect("正文锚点存在") as u32
+        + 1;
+    assert!(
+        parsed
+            .chunks
+            .iter()
+            .any(|chunk| chunk.start_line <= body_line && chunk.end_line >= body_line),
+        "{path} 正文第 {body_line} 行缺失"
+    );
+    for chunk in &parsed.chunks {
+        assert!(
+            chunk.start_line > 0
+                && chunk.start_line <= chunk.end_line
+                && chunk.end_line as usize <= lines.len(),
+            "{path} 越界块 {chunk:?}"
+        );
+    }
+    if let Some((name, start_line, end_line)) = fixture.declaration {
+        let symbol = parsed
+            .symbols
+            .iter()
+            .find(|symbol| symbol.name == name)
+            .unwrap_or_else(|| panic!("{path} 没有 {name}，实际 {:?}", parsed.symbols));
+        assert_eq!(
+            (symbol.start_line, symbol.end_line),
+            (start_line, end_line),
+            "{path} 声明范围"
+        );
+        assert!(
+            parsed
+                .chunks
+                .iter()
+                .any(|chunk| chunk.symbol_name.as_deref() == Some(name)
+                    && chunk.start_line == start_line
+                    && chunk.end_line == end_line
+                    && chunk.start_line <= body_line
+                    && chunk.end_line >= body_line),
+            "{path} 声明有名字但没有完整正文"
+        );
+    } else {
+        assert!(
+            !parsed
+                .symbols
+                .iter()
+                .any(|symbol| symbol.kind == SymbolKind::Function),
+            "{path} 将结构文本伪造为函数"
+        );
+    }
+}
+
+/// 51 个已允许扩展名必须经过各自语法；其中 txt 明确保留纯文本层级。
+#[test]
+fn every_allowed_extension_has_verified_behavior() {
+    let fixtures = [
+        Fixture {
+            paths: &["sample.rs"],
+            source: "// 汇总金额\npub fn total(value: i32) -> i32 {\n    value + 1\n}\n",
+            declaration: Some(("total", 2, 4)),
+            body: "value + 1",
+            text: false,
+        },
+        Fixture {
+            paths: &[
+                "sample.ts",
+                "sample.tsx",
+                "sample.mts",
+                "sample.cts",
+                "sample.js",
+                "sample.jsx",
+                "sample.mjs",
