+/// 计算一组绑定共用的完整类型与右值末端；省略值的分组常量止于自身名称。
+fn value_spec_end(
+    names: &[ast::Ident],
+    typ: Option<&ast::Expression>,
+    values: &[ast::Expression],
+) -> usize {
+    names
+        .iter()
+        .map(|name| text_end(name.pos, &name.name))
+        .chain(typ.map(expression_end))
+        .chain(values.iter().map(expression_end))
+        .max()
+        .unwrap_or_default()
+}
